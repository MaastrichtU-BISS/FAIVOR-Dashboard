# *************************
# Database Configuration
# *************************
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=faivor

# *************************
# Auth Configuration
# *************************
# Generate with `npx auth secret`
AUTH_SECRET=""

# *************************
# Application Settings
# *************************
NODE_ENV=development # Options: development, production
PUBLIC_ORGANIZATION_NAME="FAIVOR"

# Validator backend URL - used by the BROWSER. Must always be an address
# reachable from the user's browser (e.g. http://localhost:8000, or a
# publicly routable hostname in production). Do NOT set this to an
# internal-only Docker network hostname, or client-side requests
# (e.g. CSV/model validation triggered from the dashboard UI) will hang
# indefinitely trying to resolve/connect to it.
PUBLIC_VALIDATOR_URL=http://localhost:8000

# Optional: Validator backend URL used ONLY by server-side code (SSR,
# +server.ts routes, load functions). If set, this takes precedence over
# PUBLIC_VALIDATOR_URL for server-side requests only - it is never used
# by the browser. Useful when the dashboard and validator run in the
# same Docker Compose network and can reach each other via service name,
# e.g. http://faivor-backend:8000. Leave unset to have server-side code
# fall back to PUBLIC_VALIDATOR_URL as well.
# VALIDATOR_INTERNAL_URL=http://faivor-backend:8000

# Dashboard origin for CORS (comma-separated for multiple origins)
# Example: https://faivor.example.com,https://staging.faivor.example.com
PUBLIC_DASHBOARD_ORIGIN=http://localhost:3000
